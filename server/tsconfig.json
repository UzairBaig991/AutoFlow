{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "noEmitOnError": true
  },
  "include": ["./index.ts", "./src/**/*.ts", "./tests/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
